# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Stripe Test Mode only
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_PRICE_CREATOR_PRO=price_replace_me
STRIPE_PRICE_TEAM=price_replace_me

# ImageKit
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_replace_me
IMAGEKIT_PRIVATE_KEY=private_replace_me
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/replace_me

# Gemini API
GEMINI_API_KEY=replace_me

# Operational configuration
AI_DAILY_LIMIT_FREE=5
AI_DAILY_LIMIT_CREATOR_PRO=50
AI_DAILY_LIMIT_TEAM=200
MAX_UPLOAD_SIZE_BYTES=10485760
